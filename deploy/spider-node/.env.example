SPIDER_IMAGE=moogle/spider-node:local

# Standalone local prototype: keep the local override file enabled and leave this pointed at
# the bundled Redis service.
#
# Remote node mode: set this to a private Redis endpoint reachable by the VM that will run
# the spider node, and run only docker-compose.yml.
PIPELINE_REDIS_URL=redis://pipeline-redis:6379/0
PIPELINE_REDIS_PORT_BIND=127.0.0.1:16379

SPIDER_METRICS_PORT_BIND=127.0.0.1:22113
SPIDER_METRICS_ADDR=:2113
SPIDER_METRICS_ENABLED=true

SPIDER_STARTING_URL=https://en.wikipedia.org/wiki/Web_crawler
SPIDER_CRAWL_MODE=open
SPIDER_ALLOWLIST_DOMAINS=
SPIDER_BLOCKLIST_DOMAINS=
SPIDER_DOMAIN_MATCH_SUBDOMAINS=true

SPIDER_HTTP_TIMEOUT_SECONDS=10
SPIDER_HTTP_MAX_BODY_BYTES=2097152
SPIDER_HTTP_USER_AGENT=MoogleSpider/1.0 (+https://github.com/IonelPopJara/search-engine)

SPIDER_ROBOTS_ENABLED=true
SPIDER_ROBOTS_CACHE_TTL_SECONDS=3600
SPIDER_ROBOTS_ALLOW_ON_FETCH_FAILURE=true
SPIDER_DEFAULT_CRAWL_DELAY_MS=1000
SPIDER_MAX_CONCURRENT_PER_DOMAIN=1
SPIDER_ROBOTS_BYPASS_DOMAINS=
SPIDER_ROBOTS_BYPASS_SUBDOMAINS=true
SPIDER_ROBOTS_BYPASS_DELAY_MS=1000

SPIDER_BUDGET_ENABLED=true
SPIDER_BUDGET_RUN_MAX_ATTEMPTS=50000
SPIDER_BUDGET_RUN_MAX_SUCCESSES=30000
SPIDER_BUDGET_DOMAIN_MAX_ATTEMPTS=2000
SPIDER_BUDGET_BYPASS_MAX_RUN=200
SPIDER_BUDGET_BYPASS_MAX_DOMAIN=50

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,pipeline-redis
